          </spacer>
         </item>
         <item>
          <widget class="QPushButton" name="pb_run">
           <property name="text">
            <string>OK</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="LogsPage">
      <layout class="QVBoxLayout" name="verticalLayout_13">
