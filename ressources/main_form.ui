         <item>
          <widget class="QTextBrowser" name="textBrowser2">
           <property name="minimumSize">
            <size>
             <width>300</width>
             <height>0</height>
            </size>
           </property>
           <property name="maximumSize">
            <size>
             <width>400</width>
             <height>16777215</height>
            </size>
           </property>
           <property name="html">
            <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:9.75pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:8px; margin-bottom:8px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot; margin-top:10px; margin-bottom:2px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:10pt; font-weight:600; color:#1a5276;&quot;&gt;Mode du solveur&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Choisissez la stratégie d'optimisation adaptée à votre besoin :  &lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;tsp-path &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#a04000; background-color:#fdf2e9;&quot;&gt;1 trajet&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Chemin unique, &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;sans retour&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt; au point Home. Le départ est fixé au point  le plus éloigné de Home ; l'arrivée est Home. Idéal pour une tournée  en sens unique.  &lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;tsp-loop &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#a04000; background-color:#fdf2e9;&quot;&gt;1 boucle&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Boucle unique avec &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;retour au Home&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;. Le solveur trouve le circuit  le plus court passant par tous les points.  &lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;vrp-dist &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1e8449; background-color:#d5f5e3;&quot;&gt;Multi-boucles&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Plusieurs boucles avec une &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;distance maximale par boucle&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt; (en km ou m).  Le nombre de boucles est déterminé automatiquement par le solveur.  &lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:2px; margin-bottom:4px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Paramètre requis : &lt;span style=&quot; font-weight:600;&quot;&gt;Distance max par trajet&lt;/span&gt;  &lt;/li&gt;&lt;/ul&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;vrp-loops &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1e8449; background-color:#d5f5e3;&quot;&gt;Multi-boucles&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Plusieurs boucles avec un &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;nombre fixe de boucles&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;. Les points sont  répartis équitablement entre les boucles pour minimiser la distance totale.  &lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:2px; margin-bottom:4px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Paramètre requis : &lt;span style=&quot; font-weight:600;&quot;&gt;Nombre de boucles&lt;/span&gt;  &lt;/li&gt;&lt;/ul&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;vrp-maxpoints &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1e8449; background-color:#d5f5e3;&quot;&gt;Multi-boucles&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Plusieurs boucles avec un &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;nombre maximum de points par boucle&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;.  Le nombre de boucles est calculé automatiquement.  &lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:2px; margin-bottom:4px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Paramètre requis : &lt;span style=&quot; font-weight:600;&quot;&gt;Nombre de points max par trajet&lt;/span&gt;  &lt;/li&gt;&lt;/ul&gt;
&lt;hr /&gt;
&lt;h2 style=&quot; margin-top:10px; margin-bottom:2px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:10pt; font-weight:600; color:#1a5276;&quot;&gt;Temps de calcul&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Durée maximale allouée au solveur OR-Tools (en secondes).  Un temps plus long permet d'explorer davantage de solutions et d'obtenir  un résultat plus optimal. &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;60 s&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt; est une valeur raisonnable pour la plupart des cas.  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:5px; margin-bottom:5px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px; background-color:#fef9e7;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a; background-color:#fef9e7;&quot;&gt;    ⚠ Au-delà du temps imparti, OR-Tools retourne la meilleure solution trouvée    jusqu'alors — le calcul n'échoue pas.  &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/p&gt;
&lt;hr /&gt;
&lt;h2 style=&quot; margin-top:10px; margin-bottom:2px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:10pt; font-weight:600; color:#1a5276;&quot;&gt;Sorties&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h2&gt;
&lt;h2 style=&quot; margin-top:10px; margin-bottom:2px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;img src=&quot;:/Icon/icon/folder.svg&quot; /&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:10pt; font-weight:600; color:#1a5276;&quot;&gt; Dossier de destination&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Tous les fichiers générés seront écrits dans ce dossier.  Utilisez le bouton &lt;/span&gt;&lt;img src=&quot;:/Icon/icon/folder.svg&quot; /&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt; pour parcourir et sélectionner un répertoire.  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;📄 CSV&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Conserve le fichier &lt;/span&gt;&lt;span style=&quot; font-family:'monospace'; font-size:8.5pt; color:#1a1a1a; background-color:#f0f0f0;&quot;&gt;result_&amp;lt;mode&amp;gt;.csv&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt; dans le dossier de destination.  Contient pour chaque point : boucle, ordre de passage, coordonnées, distance depuis  le point précédent.  &lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;🗺 Memory Layer&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Crée une &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;couche mémoire QGIS&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt; (LineString) visualisant les itinéraires,  directement ajoutée au projet courant. Une ligne par boucle.  &lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;🔗 Maps.txt&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Génère un fichier texte contenant une &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;URL Google Maps&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt; par boucle,  permettant de visualiser ou partager chaque itinéraire directement dans un navigateur.  &lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:8px; margin-bottom:1px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:9pt; font-weight:600; color:#1f618d;&quot;&gt;📁 Logs (fichiers de traitement)&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;  &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Conserve les fichiers intermédiaires dans le dossier de destination :  &lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:2px; margin-bottom:2px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'monospace'; background-color:#f0f0f0;&quot;&gt;points.csv&lt;/span&gt; — liste des points transmis au solveur    &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:0px; margin-bottom:2px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'monospace'; background-color:#f0f0f0;&quot;&gt;matrix.csv&lt;/span&gt; — matrice de distances &lt;span style=&quot; font-style:italic;&quot;&gt;n × n&lt;/span&gt;    &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:0px; margin-bottom:4px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'monospace'; background-color:#f0f0f0;&quot;&gt;status.json&lt;/span&gt; — statut de fin d'exécution (succès, distances, erreurs)    &lt;/li&gt;&lt;/ul&gt;
&lt;hr /&gt;
&lt;p style=&quot; margin-top:10px; margin-bottom:0px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px; background-color:#eafaf1;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a; background-color:#eafaf1;&quot;&gt;    &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;▶ Ce qui se passe après avoir cliqué sur OK&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;    &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:4px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;Le traitement se lance en &lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; font-weight:600; color:#1a1a1a;&quot;&gt;tâche de fond QGIS&lt;/span&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt; (thread séparé, interface non bloquée) :    &lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:2px; margin-bottom:2px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Chargement des points&lt;/span&gt; — extraction depuis la couche sélectionnée + reprojection en WGS84.      &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:0px; margin-bottom:2px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Génération de la matrice&lt;/span&gt; — calcul des distances entre tous les points selon la méthode choisie.      &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:0px; margin-bottom:2px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Export CSV temporaires&lt;/span&gt; — &lt;span style=&quot; font-family:'monospace'; background-color:#f0f0f0;&quot;&gt;points.csv&lt;/span&gt; et &lt;span style=&quot; font-family:'monospace'; background-color:#f0f0f0;&quot;&gt;matrix.csv&lt;/span&gt; écrits dans le dossier de destination.      &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:0px; margin-bottom:2px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Lancement du solveur&lt;/span&gt; — OR-Tools résout le problème et écrit &lt;span style=&quot; font-family:'monospace'; background-color:#f0f0f0;&quot;&gt;result_&amp;lt;mode&amp;gt;.csv&lt;/span&gt; + &lt;span style=&quot; font-family:'monospace'; background-color:#f0f0f0;&quot;&gt;status.json&lt;/span&gt;.      &lt;/li&gt;
&lt;li style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot; style=&quot; margin-top:0px; margin-bottom:4px; margin-left:20px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Post-traitement&lt;/span&gt; — génération des sorties demandées (couche mémoire, Maps.txt…) et nettoyage des fichiers temporaires si les logs ne sont pas conservés.        &lt;/li&gt;&lt;/ul&gt;
&lt;p style=&quot; margin-top:2px; margin-bottom:4px; margin-left:8px; margin-right:8px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Segoe UI','Arial','sans-serif'; font-size:8.5pt; color:#1a1a1a;&quot;&gt;La progression et les messages s'affichent en temps réel dans le panneau de logs.  &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_8">
         <item>
          <widget class="QPushButton" name="pb_return">
           <property name="text">
            <string>Retour</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="horizontalSpacer_3">
